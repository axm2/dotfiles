// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "new_window",
  "language_models": {
    "openai_compatible": {
{{- if .work }}
      "PFB AI Gateway - OAI SDK": {
        "api_url": {{ .workGatewayUrl | quote }},
        "available_models": [
          {
            "name": "gpt-5",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 200000,
            "reasoning_effort": "high",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          },
          {
            "name": "global.anthropic.claude-sonnet-5",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "max_completion_tokens": 128000,
            "reasoning_effort": "medium",
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": true,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": true
            }
          },
          {
            "name": "global.anthropic.claude-opus-4-8",
            "max_tokens": 1000000,
            "max_output_tokens": 32768,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          },
          {
            "name": "global.anthropic.claude-opus-5",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": false,
              "parallel_tool_calls": false,
              "prompt_cache_key": false,
              "chat_completions": true,
              "interleaved_reasoning": false,
              "max_tokens_parameter": false
            }
          },
          {
            "name": "global.anthropic.claude-opus-5-5",
            "max_tokens": 1000000,
            "max_output_tokens": 128000,
            "capabilities": {
              "tools": true,
              "images": true,
              "parallel_tool_calls": true,
              "prompt_cache_key": true,
              "chat_completions": true,
              "interleaved_reasoning": true,
              "max_tokens_parameter": false
            }
          }
        ]
      }
{{- end }}
    },
    "ollama": {
      "api_url": "http://localhost:11434"
    }
  },
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "git_panel": {
    "dock": "left",
  },
  "agent_servers": {
{{- if .work }}
    "pi-acp": {
      "default_config_options": {
        "model": "pfbgateway/global.anthropic.claude-sonnet-5"
      },
      "type": "registry"
    },
{{- end }}
    "claude-acp": {
      "default_config_options": {
        "effort": "medium",
        "fast": false,
        "mode": "bypassPermissions",
        "model": "default"
      },
      "type": "registry"
    },
    "opencode": {
      "type": "registry",
    },
  },
  "context_servers": {
    "mcp-server-slack": {
      "enabled": false,
      "remote": false,
      "settings": {}
    },
    "mcp-server-github": {
      "enabled": {{ ne .githubPat "" }},
      "remote": false,
      "settings": {
        "github_personal_access_token": {{ .githubPat | quote }},
      },
    },
{{- if .work }}
    "sourcegraph": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote",
        {{ .sourcegraphUrl | quote }}
      ],
      "env": {}
    }
{{- end }}
  },
  "edit_predictions": {
    "copilot": {
      "enable_next_edit_suggestions": false,
    },
  },
  "helix_mode": true,
  "scroll_sensitivity": 0.20000000298023224,
  "minimap": {
    "show": "auto",
  },
  "base_keymap": "VSCode",
  "file_types": {
    "terraform": ["*.hcl"],
  },
  "show_whitespaces": "all",
  "wrap_guides": [120],
  "collaboration_panel": {
    "dock": "right",
  },
  "debugger": {
    "dock": "bottom",
  },
  "agent": {
    "profiles": {
    },
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "network_hosts": [
        "github.com",
        "api.github.com"
      ]
    },
    "inline_assistant_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.6",
      "enable_thinking": false,
    },
    "favorite_models": [
      {
        "provider": "copilot_chat",
        "model": "claude-sonnet-5",
        "enable_thinking": true,
        "effort": "high"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-4.8",
        "enable_thinking": false,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "claude-opus-5",
        "enable_thinking": true,
        "effort": "medium"
      },
      {
        "provider": "copilot_chat",
        "model": "gpt-6-astra",
        "enable_thinking": true,
        "effort": "high"
      }
    ],
    "dock": "right",
    "tool_permissions": {
      "tools": {
        "fetch": {
          "always_allow": [
            {
              "pattern": "^https?://raw\\.githubusercontent\\.com",
            },
          ],
        },
{{- if .work }}
        "mcp:sourcegraph:read_file": {
          "default": "allow",
        },
{{- end }}
        "mcp:mcp-server-github:search_commits": {
          "default": "allow",
        },
        "mcp:mcp-server-github:issue_read": {
          "default": "allow",
        },
        "mcp:mcp-server-github:search_pull_requests": {
          "default": "allow",
        },
        "mcp:mcp-server-github:search_issues": {
          "default": "allow",
        },
        "mcp:mcp-server-github:search_code": {
          "default": "allow",
        },
        "mcp:mcp-server-github:pull_request_read": {
          "default": "allow",
        },
        "mcp:mcp-server-github:get_file_contents": {
          "default": "allow",
        },
{{- if .work }}
        "mcp:sourcegraph:list_repos": {
          "default": "allow",
        },
        "mcp:sourcegraph:nls_search": {
          "default": "allow",
        },
        "mcp:sourcegraph:list_files": {
          "default": "allow",
        },
        "mcp:sourcegraph:keyword_search": {
          "default": "allow",
        },
{{- end }}
        "terminal": {
          "always_allow": [
            {
              "pattern": "^cat\\b"
            },
            {
              "pattern": "^echo\\s+done(\\s|$)"
            },
            {
              "pattern": "^sed\\b"
            },
            {
              "pattern": "^grep\\b"
            },
            {
              "pattern": "^grep\\s+Run(\\s|$)"
            },
            {
              "pattern": "^head\\b"
            },
            {
              "pattern": "^awk\\b"
            },
            {
              "pattern": "^sort\\b"
            },
            {
              "pattern": "^python3\\b"
            }
          ],
        },
      },
    },
    "button": true,
    "enabled": true,
    "default_profile": "write",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "copilot_chat",
      "model": "claude-sonnet-5.5",
    },
  },
  "vim_mode": true,
  "ui_font_size": 14,
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "light": "Ayu Light",
    "dark": "Cisco Dark",
  },
  "languages": {
    "Python": {
      "language_servers": ["!ty", "!ruff", "basedpyright", "!pyright", "!pylsp"],
    },
  },
  "terminal": {
    "line_height": {
      "custom": 1.2,
    },
  },
{{- if stat "/opt/homebrew/opt/llvm/bin/clangd" }}
  "lsp": {
    "clangd": {
      "binary": {
        "path": "/opt/homebrew/opt/llvm/bin/clangd",
      },
    },
  },
{{- end }}
}
